{
  "readymade_form": 1,
  "name": "Form1",
  "text": "Anchors: resize this window",
  "width": 480,
  "height": 344,
  "default_button": "btnAdd",
  "cancel_button": "btnClose",
  "controls": [
    {
      "type": "Label",
      "name": "lblTitle",
      "left": 16,
      "top": 12,
      "width": 300,
      "height": 24,
      "alignment": "left",
      "anchor": "top left",
      "backcolor": "",
      "cursor": "default",
      "enabled": true,
      "font": "",
      "forecolor": "",
      "tag": "",
      "text": "Things to do:",
      "tooltip": "",
      "valignment": "middle",
      "visible": true
    },
    {
      "type": "TextBox",
      "name": "txtItem",
      "left": 16,
      "top": 40,
      "width": 352,
      "height": 24,
      "alignment": "left",
      "anchor": "top left right",
      "backcolor": "",
      "cursor": "default",
      "enabled": true,
      "font": "",
      "forecolor": "",
      "maxlength": 0,
      "multiline": false,
      "password": false,
      "readonly": false,
      "scrollbars": "none",
      "tabindex": 0,
      "tag": "",
      "text": "",
      "tooltip": "Type something to do, then press Enter or Add",
      "visible": true
    },
    {
      "type": "Button",
      "name": "btnAdd",
      "left": 376,
      "top": 38,
      "width": 88,
      "height": 28,
      "alignment": "center",
