      "backcolor": "",
      "cursor": "default",
      "enabled": true,
      "font": "",
      "forecolor": "",
      "tabindex": 0,
      "tag": "",
      "text": "Add",
      "tooltip": "",
      "valignment": "middle",
      "visible": true
    },
    {
      "type": "ListBox",
      "name": "lstItems",
      "left": 16,
      "top": 76,
      "width": 352,
      "height": 216,
      "anchor": "top bottom left right",
      "backcolor": "",
      "cursor": "default",
      "enabled": true,
      "font": "",
      "forecolor": "",
      "items": [
        "Resize the window",
        "Watch the controls"
      ],
      "tabindex": 0,
      "tag": "",
      "tooltip": "",
      "visible": true
    },
    {
